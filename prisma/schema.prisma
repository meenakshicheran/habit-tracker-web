generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  xp              Int           @default(0)
  level           Int           @default(1)
  freezeTokens    Int           @default(3)
  lastTokenReset  DateTime?
  onboardingDone       Boolean       @default(false)
  reminderTime         String?
  notificationsEnabled Boolean       @default(true)
  defaultCategory      String        @default("General")
  createdAt            DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  accounts       Account[]
  sessions       Session[]
  habits         Habit[]
  dailyInsights  DailyInsight[]
  freezeEvents   FreezeEvent[]
  journals       JournalEntry[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  title         String
  description   String?
  icon          String   @default("✅")
  color         String   @default("#000000")
  category      String   @default("General")
  frequency     String   @default("daily")
  targetDays    Int      @default(7)
  reminderTime  String?
  scheduledTime String   @default("anytime")
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs     HabitLog[]
  streak   Streak?
  freezes  StreakFreeze[]
  journals JournalEntry[]

  @@index([userId])
  @@index([userId, archived])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String
  completed Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId, date])
}

model Streak {
  id          String  @id @default(cuid())
  habitId     String  @unique
  current     Int     @default(0)
  longest     Int     @default(0)
  lastChecked String?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model WeeklyChallenge {
  id          String   @id @default(cuid())
  weekStart   String   @unique
  title       String
  description String
  targetDays  Int      @default(5)
  xpReward    Int      @default(100)
  createdAt   DateTime @default(now())

  participants UserWeeklyChallenge[]
}

model UserWeeklyChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  claimedAt   DateTime?

  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
}

model StreakFreeze {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId])
}

model DailyInsight {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model FreezeEvent {
  id        String   @id @default(cuid())
  userId    String
  habitId   String?
  date      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String
  content   String
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId])
}
